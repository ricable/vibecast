# ============================================
# ERICSSON RAN AUTOMATION - ENVIRONMENT CONFIG
# ============================================

# --- E2B Sandbox Configuration ---
# Required for spawning 500 sandboxes
E2B_API_KEY=your-e2b-api-key

# --- LLM Provider Configuration ---
# Gemini API key for agentic-flow
GEMINI_KEY=your-gemini-api-key
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Alternative: OpenRouter for cost optimization
OPENROUTER_API_KEY=sk-or-v1-your-key-here
COMPLETION_MODEL=deepseek/deepseek-chat

# --- Provider Selection ---
PROVIDER=gemini
USE_OPENROUTER=false

# --- Model Configuration ---
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Proxy Configuration ---
PROXY_PORT=3000
ANTHROPIC_BASE_URL=http://localhost:3000

# --- Agent Configuration ---
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_MS=300000

# --- Time Series Configuration ---
TS_GRANULARITIES=hourly,daily,weekly
TS_PREDICTION_HORIZON=168  # hours (1 week)
TS_LOOKBACK_PERIOD=720     # hours (30 days)

# --- Ericsson RAN Configuration ---
RAN_NODE_TYPES=gNB,eNB,5G-SA,4G-LTE
CELL_AGGREGATION_LEVELS=cell,sector,cluster,region
KPI_GRANULARITY_MINUTES=15
ENM_EXPORT_PATH=./data/enm-exports
OPTIMIZATION_HISTORY_PATH=./data/optimization-history

# --- Vector Database Configuration ---
RUVECTOR_DIMENSIONS=1536
RUVECTOR_INDEX_TYPE=hnsw
RUVECTOR_DB_PATH=./data/ran-vectors.db

# --- Claude-Flow Configuration ---
CLAUDE_FLOW_MEMORY_PATH=./memory
CLAUDE_FLOW_METRICS_PATH=./.claude-flow/metrics

# --- Database Configuration ---
DB_PATH=./data/agentdb
TIMESERIES_DB_PATH=./data/timeseries

# --- Sandbox Configuration ---
SANDBOX_COUNT=500
SANDBOX_BATCH_SIZE=50
SANDBOX_TIMEOUT_MS=300000

# --- Logging ---
LOG_LEVEL=info
LOG_PATH=./logs
