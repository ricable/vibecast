{
  "name": "ericsson-ran-advanced-automation",
  "version": "2.0.0",
  "description": "Most advanced Ericsson RAN automation platform with ruvector, self-learning vectors, GNN, semantic routing, and distributed operations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "demo": "tsx examples/advanced-ruvector-demo.ts",
    "demo:vectors": "tsx -e \"import('./examples/advanced-ruvector-demo.ts').then(m => m.demoVectorDatabase())\"",
    "demo:gnn": "tsx -e \"import('./examples/advanced-ruvector-demo.ts').then(m => m.demoSelfLearningGNN())\"",
    "demo:router": "tsx -e \"import('./examples/advanced-ruvector-demo.ts').then(m => m.demoSemanticRouter())\"",
    "orchestrator": "tsx src/orchestrator/index.ts",
    "orchestrator:advanced": "tsx src/ruvector/advanced-ran-orchestrator.ts",
    "agent:ran-docs": "tsx src/agents/ran-docs-agent.ts",
    "agent:alarms": "tsx src/agents/alarm-fault-agent.ts",
    "agent:kpi": "tsx src/agents/kpi-analyzer-agent.ts",
    "agent:config": "tsx src/agents/config-management-agent.ts",
    "ruvector:server": "npx ruvector server --port 8080 --cors",
    "ruvector:stats": "npx ruvector stats ./ruvector-data",
    "ruvector:gnn:info": "npx ruvector gnn info",
    "ruvector:cluster:status": "npx ruvector cluster --status"
  },
  "keywords": [
    "ericsson",
    "ran",
    "5g",
    "automation",
    "ruvector",
    "vector-database",
    "gnn",
    "graph-neural-network",
    "self-learning",
    "anomaly-detection",
    "semantic-routing",
    "distributed",
    "multi-agent",
    "claude-ai",
    "embeddings"
  ],
  "dependencies": {
    "@agentic/core": "^7.0.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@ruvector/agentic-synth": "^0.1.5",
    "@ruvector/core": "^0.1.15",
    "@ruvector/gnn": "^0.1.15",
    "@ruvector/graph-node": "^0.1.15",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "lodash-es": "^4.17.21",
    "ruvector-extensions": "^0.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
